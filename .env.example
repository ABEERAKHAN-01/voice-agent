# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/patients

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# --- OpenAI (Vapi uses this as the LLM provider) ---
OPENAI_API_KEY=sk-...

# --- Vapi ---
VAPI_API_KEY=your_vapi_private_key
VAPI_PUBLIC_KEY=your_vapi_public_key
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=choose_a_long_random_string
VAPI_SERVER_URL=https://your-app.up.railway.app/vapi/webhook

# --- Twilio (OPTIONAL: only needed if USE_TWILIO_IMPORT=true, for a
# non-US number or a number you already own. Otherwise leave blank —
# setup_vapi.py will provision a free US number directly from Vapi.) ---
USE_TWILIO_IMPORT=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
